# Sao chép thành .env.local (chạy máy) và nhập các biến này trên Vercel → Settings → Environment Variables.
# Thiếu biến Supabase thì app tự chạy CHẾ ĐỘ DEMO (dữ liệu trong bộ nhớ, tài khoản demo/demo, test/test).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Khóa anon/publishable — chỉ dùng trên server để đăng nhập
SUPABASE_ANON_KEY=
# Khóa service_role/secret — TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Bản đồ & đường đi (OpenStreetMap, miễn phí) ---
# Tùy chọn: khóa OpenRouteService (đăng ký miễn phí tại openrouteservice.org, 2.000 lượt/ngày).
# Không có thì tính đường bằng máy chủ OSRM công cộng.
ORS_API_KEY=
# Tùy chọn: style bản đồ khác (mặc định OpenFreeMap "liberty", không cần khóa)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- App ---
# Địa chỉ app, dùng để in mã QR (npm run qr:print)
APP_URL=https://ten-app.vercel.app
# Tiêu đề trang — đừng để lộ bất ngờ
NEXT_PUBLIC_APP_TITLE=Cuộc Đua Bí Mật
# Tài khoản "linh" sẽ đăng nhập bằng email linh@<domain> trong Supabase Auth
LOGIN_EMAIL_DOMAIN=players.race
