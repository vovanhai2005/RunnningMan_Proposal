{
  "name": "race-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "content:push": "node --env-file-if-exists=.env.local --import tsx scripts/push-content.mts",
    "player:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-player.mts",
    "player:reset": "node --env-file-if-exists=.env.local --import tsx scripts/reset-player.mts",
    "qr:print": "node --env-file-if-exists=.env.local --import tsx scripts/print-qr.mts",
    "status": "node --env-file-if-exists=.env.local --import tsx scripts/status.mts",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "predev": "node scripts/copy-map-worker.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "canvas-confetti": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.5",
    "qr-scanner": "^1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
