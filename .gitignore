# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# nội dung thật (đáp án) và bản in QR — không đưa lên git
/content/stages.json
/print/

# ảnh/video kỷ niệm gốc (nặng, riêng tư); chỉ commit bản nhẹ trong public/memories
# do `npm run memories:build` tạo ra
/src/assets/stage/

# worker MapLibre (tự chép khi npm install / build)
/public/vendor/

# tài liệu kế hoạch (lộ bất ngờ) — không đưa lên git
/*.pdf
